{
  "manifest_version": 3,
  "name": "DarkerNews",
  "version": "1.0.0",
  "description": "A dark mode theme for Hacker News, inspired by junesyi.dev",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["*://news.ycombinator.com/*"],
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
